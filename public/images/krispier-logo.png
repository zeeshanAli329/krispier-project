<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 420 120" width="100%" height="100%" fill="none">
  <!-- Pizza Slice / Sauce Splash Emblem Above Lettering -->
  <g transform="translate(18, 12)">
    <!-- Pizza Slice Crust -->
    <path d="M 8 16 C 24 10, 48 10, 64 16 L 36 68 Z" fill="#FFC400" stroke="#FFB800" stroke-width="2"/>
    <!-- Pizza Crust Edge -->
    <path d="M 6 16 C 24 8, 48 8, 66 16 C 68 20, 64 24, 60 22 C 45 16, 27 16, 12 22 C 8 24, 4 20, 6 16 Z" fill="#FFA000"/>
    <!-- Pepperoni / Topping dots -->
    <circle cx="36" cy="30" r="5" fill="#EF4444"/>
    <circle cx="26" cy="44" r="4.5" fill="#EF4444"/>
    <circle cx="44" cy="44" r="4" fill="#EF4444"/>
    <!-- Sauce Drips from Tip -->
    <path d="M 36 68 C 36 76, 39 80, 41 84 C 42 86, 38 88, 36 86 C 34 84, 33 76, 34 68 Z" fill="#FFC400"/>
    <circle cx="41" cy="91" r="2.5" fill="#FFC400"/>
  </g>

  <!-- Stylized KRISPIER Wordmark -->
  <g fill="#FFC400" transform="translate(88, 62)">
    <!-- Main Bold Stylized Text -->
    <text x="0" y="0" font-family="'Impact', 'Arial Black', 'Outfit', sans-serif" font-size="52" font-weight="900" letter-spacing="2" fill="#FFC400">
      KRISPIER
    </text>
  </g>

  <!-- Tagline Banner: Delight In Every Sauce -->
  <g transform="translate(90, 88)">
    <rect x="0" y="0" width="230" height="20" rx="4" fill="#222222" stroke="#353535" stroke-width="1"/>
    <!-- Small Sauce Drip Accent -->
    <circle cx="12" cy="10" r="3.5" fill="#FFC400"/>
    <text x="24" y="14" font-family="'Plus Jakarta Sans', system-ui, sans-serif" font-size="11" font-weight="800" letter-spacing="2.2" fill="#FFFFFF">
      DELIGHT IN EVERY SAUCE
    </text>
  </g>
</svg>
